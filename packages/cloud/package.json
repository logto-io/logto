{
  "name": "@meshx/cloud",
  "version": "0.1.0",
  "description": "MeshX Cloud: the license service (signs self-hosted license keys) and, later, billing.",
  "author": "Silverhand Inc. <contact@silverhand.io>",
  "license": "MPL-2.0",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput --incremental",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src",
    "test": "vitest run src"
  },
  "engines": {
    "node": "^22.14.0 || ^26.0.0"
  },
  "dependencies": {
    "@logto/schemas": "workspace:^",
    "@silverhand/slonik": "31.0.0-beta.2",
    "@withtyped/server": "^0.14.0",
    "jose": "^6.2.3",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@silverhand/eslint-config": "6.0.1",
    "@silverhand/ts-config": "6.0.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.56.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  },
  "eslintConfig": {
    "extends": "@silverhand",
    "rules": {
      "no-console": "error"
    }
  },
  "prettier": "@silverhand/eslint-config/.prettierrc",
  "exports": {
    ".": "./lib/index.js",
    "./routes": "./lib/routes.js"
  },
  "files": [
    "lib"
  ]
}
