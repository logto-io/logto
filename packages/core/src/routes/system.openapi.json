{
  "tags": [
    {
      "name": "Systems",
      "description": "Endpoints for system constants and information."
    }
  ],
  "paths": {
    "/api/systems/application": {
      "get": {
        "summary": "Get the application constants.",
        "description": "Get the application constants.",
        "responses": {
          "200": {
            "description": "The application constants."
          }
        }
      }
    },
    "/api/systems/license": {
      "get": {
        "tags": ["Dev feature"],
        "summary": "Get the installed license.",
        "description": "Get the license installed on this self-hosted deployment, i.e. the plan it grants, the entitlements it unlocks, its expiration, and its refresh/grace status. The license key itself is never returned. Returns 404 when no license is installed, and 501 on Logto Cloud.",
        "responses": {
          "200": {
            "description": "The installed license.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "plan",
                    "env",
                    "quota",
                    "expiresAt",
                    "installedAt",
                    "lastRefreshedAt",
                    "graceEndsAt"
                  ],
                  "properties": {
                    "plan": {
                      "type": "string",
                      "enum": ["self-hosted-pro", "self-hosted-enterprise"]
                    },
                    "env": {
                      "type": "string",
                      "enum": ["production", "non-production"]
                    },
                    "quota": {
                      "type": "object"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "installedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "lastRefreshedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "graceEndsAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "refusalReason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No license is installed on this deployment."
          },
          "501": {
            "description": "Licenses are only available on self-hosted deployments."
          }
        }
      },
      "put": {
        "tags": ["Dev feature"],
        "summary": "Install a license.",
        "description": "Install a license key on this self-hosted deployment, replacing the installed license if there is one. The key's signature is verified against the public key built into Logto before it is saved, and a key past its expiration is rejected as a stale copy. Returns 501 on Logto Cloud.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "license": {
                    "description": "The license key to install, as issued by Logto Cloud."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The license has been installed."
          },
          "400": {
            "description": "The license key is invalid or has been tampered with, or it has expired."
          },
          "501": {
            "description": "Licenses are only available on self-hosted deployments."
          }
        }
      }
    }
  }
}
